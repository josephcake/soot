# intelligent-agent-router environment configuration
#
# Copy to .env for local development. NEVER commit .env (it is git-ignored).
# Full documentation: docs/configuration.md
#
# Milestone 0 status: only the IAR_* variables below are read (by parseEnv in
# @intelligent-agent-router/core). Nothing loads .env files automatically yet.

# Log verbosity: silent | error | warn | info | debug   (default: info)
IAR_LOG_LEVEL=info

# Local-first state directory (future SQLite DB, worktrees, audit log).
# Default: ~/.intelligent-agent-router   Relative paths resolve against the cwd.
# IAR_DATA_DIR=

# --- Provider credentials (bring your own keys) -----------------------------
# RESERVED. No provider integration exists yet (planned for Milestone 2), so
# NO code reads these today. Names follow the LiteLLM/provider conventions.
# Leave them empty here; put real values only in your untracked .env.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
