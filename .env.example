# soot environment configuration
#
# Copy to .env for local development. NEVER commit .env (it is git-ignored).
# Full documentation: docs/configuration.md
#
# SOOT_* variables are parsed by parseEnv in @soot/core and used by the soot CLI
# and `soot mcp`. Nothing loads .env files automatically; export variables in
# your shell.

# Log lines on stderr: silent | error | warn | info | debug   (default: info)
SOOT_LOG_LEVEL=info

# Local-first state directory (soot.sqlite, reports, audit logs, worktrees).
# Default: ~/.soot   Relative paths resolve against the cwd.
# SOOT_DATA_DIR=

# --- Provider credentials (bring your own keys) -----------------------------
# Read ONLY by @soot/provider-adapters, from the variable a model config names
# (apiKeyEnv). Never logged or put in task context (ADR-022). Anthropic and
# OpenAI have adapters (Milestone 2, mock-verified); the others are reserved.
# DeepSeek endpoints are refused by policy (ADR-016) even if a key is set.
# Leave them empty here; put real values only in your untracked .env.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
