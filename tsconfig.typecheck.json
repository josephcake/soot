{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@soot/cli": ["./apps/cli/src/index.ts"],
      "@soot/dashboard": ["./apps/dashboard/src/index.ts"],
      "@soot/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["apps/*/src/**/*.ts", "packages/*/src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
