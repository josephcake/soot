{
  "$id": "https://soot.dev/schema/agent-result.schema.json",
  "title": "soot agent result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "blocked", "cancelled"]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "findings": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["observation", "issue", "risk", "decision"]
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          },
          "files": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        "required": ["kind", "message"],
        "additionalProperties": false
      }
    },
    "patch": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": ["unified-diff", "git-commit"]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "filesChanged": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          },
          "required": ["format", "ref", "filesChanged"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["test", "command", "inspection", "diff"]
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "passed": {
            "type": ["boolean", "null"]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": ["kind", "description", "passed"],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "costUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["inputTokens", "outputTokens", "durationMs", "costUsd", "model"],
      "additionalProperties": false
    },
    "signals": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "complexity": {
          "type": "string",
          "enum": ["lower", "as-expected", "higher"]
        },
        "toolErrors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unmetCriteria": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "planReady": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["taskId", "attempt", "status", "summary", "findings", "patch", "evidence", "usage"],
  "additionalProperties": false
}
