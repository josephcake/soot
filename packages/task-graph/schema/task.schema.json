{
  "$id": "https://soot.dev/schema/task.schema.json",
  "title": "soot task",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "instructions": {
      "type": "string",
      "maxLength": 8000
    },
    "acceptanceCriteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "requiredCapabilities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,47}$"
      }
    },
    "complexity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "estimate": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["inputTokens", "outputTokens", "costUsd"],
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "required": ["read", "write"],
      "additionalProperties": false
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    }
  },
  "required": [
    "id",
    "title",
    "instructions",
    "acceptanceCriteria",
    "requiredCapabilities",
    "complexity",
    "estimate",
    "files",
    "dependsOn"
  ],
  "additionalProperties": false
}
