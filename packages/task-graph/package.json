{
  "name": "@soot/task-graph",
  "version": "0.0.0",
  "private": true,
  "description": "Task and agent-result contracts (validators + JSON Schema) and the dependency graph.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts --project @soot/task-graph",
    "schema": "tsc -b && node scripts/write-schemas.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
