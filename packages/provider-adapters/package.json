{
  "name": "@soot/provider-adapters",
  "version": "0.0.0",
  "private": true,
  "description": "Provider abstraction over the Vercel AI SDK (in-process): Anthropic, OpenAI, OpenAI-compatible endpoints; retries, rate limits, fallback, discovery, credential isolation.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts --project @soot/provider-adapters"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.102",
    "@ai-sdk/openai": "4.0.115",
    "@ai-sdk/openai-compatible": "3.0.90",
    "@ai-sdk/provider": "4.0.37",
    "@soot/model-registry": "workspace:*",
    "ai": "7.0.170",
    "zod": "^4.6.7"
  }
}
