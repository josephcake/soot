{
  "name": "@soot/integrations",
  "version": "0.0.0",
  "private": true,
  "description": "Codebase integration and safety: per-task git worktrees, write-scope leases, soot-run validation, serial merge-tree integration, approval-gated working-tree updates, reports, audit log.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts --project @soot/integrations"
  },
  "dependencies": {
    "@soot/agent-runtime": "workspace:*",
    "@soot/context-manager": "workspace:*",
    "@soot/observability": "workspace:*",
    "@soot/task-graph": "workspace:*"
  }
}
