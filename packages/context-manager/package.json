{
  "name": "@soot/context-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Persisted execution state in SQLite (node:sqlite) under SOOT_DATA_DIR; resume after interruption. Context selection comes later.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts --project @soot/context-manager"
  },
  "dependencies": {
    "@soot/agent-runtime": "workspace:*",
    "@soot/task-graph": "workspace:*"
  }
}
