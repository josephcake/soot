{
  "name": "@soot/cli",
  "version": "0.0.0",
  "private": true,
  "description": "soot command-line interface: run, models, status, config, cost, stop, mcp, install-skill, dashboard (optional) (Milestone 6, fixture-backed).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts --project @soot/cli"
  },
  "dependencies": {
    "@soot/agent-runtime": "workspace:*",
    "@soot/context-manager": "workspace:*",
    "@soot/core": "workspace:*",
    "@soot/escalation": "workspace:*",
    "@soot/harness-adapters": "workspace:*",
    "@soot/integrations": "workspace:*",
    "@soot/model-registry": "workspace:*",
    "@soot/model-router": "workspace:*",
    "@soot/observability": "workspace:*",
    "@soot/planner": "workspace:*",
    "@soot/provider-adapters": "workspace:*",
    "@soot/task-graph": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "soot": "./dist/bin.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@soot/dashboard": "workspace:*"
  },
  "peerDependencies": {
    "@soot/dashboard": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@soot/dashboard": {
      "optional": true
    }
  }
}
